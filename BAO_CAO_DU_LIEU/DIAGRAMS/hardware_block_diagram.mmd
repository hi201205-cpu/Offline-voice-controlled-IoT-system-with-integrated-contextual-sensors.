    subgraph AudioIn ["Âm Thanh"]
        INMP441["Microphone INMP441 MEMS"] -->|3.3V, I2S| GPIO_I2S
    end

    subgraph Sensing ["Cảm Biến"]
        DHT22["Cảm biến nhiệt ẩm DHT22"] -->|3.3V, Data| GPIO_1WIRE
