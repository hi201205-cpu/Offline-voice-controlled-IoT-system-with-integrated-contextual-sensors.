        Buck --> Rail3V3["Đường nguồn 3.3V"]
        Rail5V --> Cap["Tụ lọc nguồn 1000uF + 100nF"]
    end

    subgraph MCU ["ESP32-S3-WROOM-1 / DevKitC-1 N16R8"]
        GPIO_I2S["I2S0 (GPIO 4, 5, 6)"]
        GPIO_UART["UART1 (GPIO 10, 11)"]
        GPIO_ADC["ADC1_CH0 (GPIO 1)"]
        GPIO_1WIRE["1-Wire (GPIO 16)"]
        GPIO_PWM["LEDC PWM (GPIO 9, 39, 17, 18, 8, 48)"]
        GPIO_OUT["Digital Output (GPIO 40, 41, 42)"]
        GPIO_IN["Digital Input Pullup (GPIO 2, 3, 7, 12, 13, 14, 15, 21, 38, 47)"]
