        Relays --> YardLight["Đèn Sân Vườn 220VAC / 12VDC"]

        GPIO_PWM --> Servos["Servo MG996R / SG90 (5V Rail)"]
        Servos --> DoorMechanic["Cơ cấu Cửa trượt"]
        Servos --> CurtainMechanic["Cơ cấu Rèm tự động"]
        
        GPIO_PWM --> RGB["LED RGB (Chỉ thị trạng thái AI)"]
        GPIO_PWM --> Buzzer["Còi báo động Buzzer Active 5V"]
    end

    subgraph SecurityInput ["Bảo Mật & Giao Tiếp"]
        Keypad["Bàn phím ma trận 4x3"] --> GPIO_IN
        Switches["Công tắc hành trình Cửa (Đóng/Mở)"] --> GPIO_IN
        BtnDoor["Nút bấm Mở cửa trong nhà (+10k Pullup)"] --> GPIO_IN
