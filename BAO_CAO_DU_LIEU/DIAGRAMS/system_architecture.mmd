            Queue["Inter-Core FreeRTOS Queue (s_fbQueue)"]
            FirebaseDriver["Firebase ESP Client SDK"]
            Queue --> FirebaseDriver
        end

        IntentDispatcher -.->|Async Event| Queue
        ContextEngine -.->|Telemetry Event| Queue
        DoorSecurity -.->|Security Event| Queue
    end

