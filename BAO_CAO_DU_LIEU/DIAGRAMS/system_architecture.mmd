            VAD --> MFCC["MFCC Feature Extraction (13 coeff, 32 filterbanks)"]
            MFCC --> CNN["INT8 Quantized CNN Model (Edge Impulse)"]
            CNN --> IntentDispatcher["Local Command Dispatcher"]
        end

        subgraph Peripherals ["Peripheral Control & Sensing"]
            Sensors["DHT22 (GPIO16), LD2410S mmWave (GPIO10,11), LDR (GPIO1)"] --> ContextEngine["Context-aware Automation Engine"]
